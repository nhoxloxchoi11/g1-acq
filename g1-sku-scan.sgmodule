#!name=G1 SKU Scan
#!desc=URL + Location + Base64/protobuf discovery; SKU + offerIdToken scan; loc g1.ios.ai.pro / 12months_eft; 采集 one.google.com 响应中的候选 SKU，保持响应原文；在本机报告页查看与导出
#!system=ios

[Rule]
# 与旧模块相同：拦截 UDP 443，作用于使用该配置的流量。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-sku-scan = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/nhoxloxchoi11/g1-acq@v7.7.0/g1-sku-scan.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/nhoxloxchoi11/g1-acq@v7.7.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
