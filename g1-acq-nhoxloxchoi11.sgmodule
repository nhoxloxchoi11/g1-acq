#!name=G1 ACQ - nhoxloxchoi11
#!desc=nhoxloxchoi11 v7.5.2 | 20TB -> g1.2tb.ai.18months_eft | 30TB -> g1.ai.ultra.1month_eft.acq | Scripts: nhoxloxchoi11/g1-acq. Tat module G1 ACQ cu truoc khi bat.
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-nhox-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/nhoxloxchoi11/g1-acq@v7.5.2/g1-acq.js
g1-nhox-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/nhoxloxchoi11/g1-acq@v7.5.2/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
