#!name=G1 ACQ
#!desc=SKU + offerIdToken scan; loc g1.ios.ai.pro / 12months_eft; v7.6.0：被动采集原始 SKU，最近10次响应/本次新增/重复诊断；原2TB入口目标 g1.2tb.ai.12months_ip_90p；新增 g1.ios.ai.2tb.m.ip_1mo_90p.acq -> g1.2tb.ai.12months_eft；20TB 固定 g1.2tb.ai.18months_eft；30TB 固定 g1.ai.ultra.1month_eft.acq；本机报告与 JSON 导出
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/nhoxloxchoi11/g1-acq@v7.6.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/nhoxloxchoi11/g1-acq@v7.6.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
